# --------------------------------------------------------------------------
# meta: Static reference data (timezones, Unsplash proxy).
# 2 route(s), 6 endpoint x method pair(s); PLANE_RS_GROUP_META=django sends them back.
# --------------------------------------------------------------------------
@plane_rs_meta {
	expression <<CEL
		({env.PLANE_RS_GROUP_META} == "" ? "rust" : {env.PLANE_RS_GROUP_META}) == "rust"
		&& (
			(method("GET") && (path_regexp(r"^/api/timezones/$")))
		)
	CEL
}
handle @plane_rs_meta {
	reverse_proxy {$PLANE_RS_API_UPSTREAM:plane-api:8000}
}

# --------------------------------------------------------------------------
