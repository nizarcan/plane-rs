#
# Production images for the Rust background services: `plane-worker`,
# `plane-beat` and the one-off `plane-migrator` that creates the
# `plane_jobs` schema.
#
# Local/exit-check builds name the role explicitly:
#
#   docker build -f apps/server/deploy/docker/Dockerfile.plane-jobs \
#     --target worker -t plane-worker:latest .
#   docker build -f apps/server/deploy/docker/Dockerfile.plane-jobs \
#     --target beat -t plane-beat:latest .
#   docker build -f apps/server/deploy/docker/Dockerfile.plane-jobs \
#     --target migrator -t plane-migrator:latest .
#
# The release action (`makeplane/actions/build-push`) does not expose Docker's
# `--target`, so it builds the default `image` stage with a build argument:
#
#   docker build -f apps/server/deploy/docker/Dockerfile.plane-jobs \
#     --build-arg JOBS_BINARY=plane-worker -t plane-worker:latest .
#   ... JOBS_BINARY=plane-beat / plane-migrator
#
# `JOBS_BINARY=all` (the default) compiles and installs all three binaries for
# the explicit targets; a single role name compiles only that binary and
# installs it as `/usr/local/bin/plane-jobs` in the default stage. The binary's
# name inside the image is an implementation detail of the image; the entrypoint
# selects it.
#
# The build context is the repository root, like `Dockerfile.plane-api`; its
# own ignore file keeps the rest of the checkout out of the context. The
# builder stage uses the same base,
# packages and target cache as `Dockerfile.plane-api`'s, so a machine that
# built that image reuses the cargo caches and only links the binaries here.
#
# The role stages are separate images on purpose: a worker does not carry the
# scheduler, the linker-stripped binaries are 30-60 MB each, and the idle-memory
# benchmark in BENCH.md quotes each image's size next to its container.

ARG RUST_VERSION=1.99.1

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------
# Same base and packages as `Dockerfile.plane-api`. Keep the two stages in step:
# aws-lc-rs needs cmake/perl/a C compiler, and lld links the binaries.
FROM rust:${RUST_VERSION}-slim-bookworm AS builder

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        build-essential \
        ca-certificates \
        cmake \
        lld \
        perl \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/apps/server

COPY apps/server/Cargo.toml apps/server/Cargo.lock apps/server/routes.json ./
COPY apps/server/crates ./crates
COPY apps/server/bins ./bins
# `[patch.crates-io] zxcvbn = { path = "vendor/zxcvbn" }` (Cargo.toml): the
# workspace does not build without the vendored crate, and it is a separate
# workspace (excluded above), so it has to be copied explicitly.
COPY apps/server/vendor ./vendor
# `plane-migrator` embeds the Django baseline (`deploy/schema/baseline.sql` and
# `django_migrations.txt`, `bins/plane-migrator/src/schema.rs`) and the worker
# links the same crates as the api, so both committed `deploy/` inputs are
# compile-time dependencies.
COPY apps/server/deploy/openapi ./deploy/openapi
COPY apps/server/deploy/schema ./deploy/schema

ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}

# `all` keeps the explicit `--target worker|beat|migrator` builds working; a
# role name lets the release action build one binary per published image.
ARG JOBS_BINARY=all

# The release profile is the workspace's (fat LTO, one codegen unit,
# panic=abort, strip). `cargo rustc` adds lld to the final compilation only, so
# the dependency fingerprints stay identical to `Dockerfile.plane-api`'s and
# the shared target cache mount is reused. Each invocation links one binary;
# `cargo build` would link all three with GNU ld.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/apps/server/target \
    set -eu; \
    if [ "$JOBS_BINARY" = "all" ]; then \
        binaries="plane-worker plane-beat plane-migrator"; \
        selected="plane-worker"; \
    else \
        binaries="$JOBS_BINARY"; \
        selected="$JOBS_BINARY"; \
    fi; \
    for binary in $binaries; do \
        cargo rustc --release --locked -p "$binary" -- -C link-arg=-fuse-ld=lld; \
    done; \
    for binary in $binaries; do \
        install -D -m 0755 "/build/apps/server/target/release/$binary" "/out/$binary"; \
    done; \
    install -D -m 0755 "/out/$selected" /out/plane-jobs

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Distroless `cc` carries glibc, libgcc and the CA bundle (for S3, webhooks and
# OAuth on the task paths) and nothing else. `:nonroot` is UID 65532 with no
# home directory; these services write no state to disk, logs go to stdout.
FROM gcr.io/distroless/cc-debian12:nonroot AS worker
COPY --from=builder /out/plane-worker /usr/local/bin/plane-worker
ENTRYPOINT ["/usr/local/bin/plane-worker"]

FROM gcr.io/distroless/cc-debian12:nonroot AS beat
COPY --from=builder /out/plane-beat /usr/local/bin/plane-beat
ENTRYPOINT ["/usr/local/bin/plane-beat"]

FROM gcr.io/distroless/cc-debian12:nonroot AS migrator
COPY --from=builder /out/plane-migrator /usr/local/bin/plane-migrator
ENTRYPOINT ["/usr/local/bin/plane-migrator"]

# The release action names no target, so it builds this last stage. The
# `JOBS_BINARY` build argument decided which binary `/out/plane-jobs` holds
# (`plane-worker` by default, matching the `worker` stage).
FROM gcr.io/distroless/cc-debian12:nonroot AS image
COPY --from=builder /out/plane-jobs /usr/local/bin/plane-jobs
ENTRYPOINT ["/usr/local/bin/plane-jobs"]
