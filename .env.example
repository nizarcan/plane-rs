# plane-rs service environment. `./setup.sh` copies this file to `.env` and
# fills in SECRET_KEY and the object-storage credentials; docker compose and the
# Rust services both read `.env`. Never commit `.env`.
#
# Every variable keeps the name upstream's Django backend used (ENV.md): an
# existing deployment can carry its environment over unchanged. Django-only
# settings (RABBITMQ_*, CELERY_*, GUNICORN_*) are not needed; the Rust loader
# still accepts them if an old file has them.

# --- core ------------------------------------------------------------------
DEBUG=0
# Generated by setup.sh. Changing it invalidates encrypted instance
# configuration rows and existing sessions/CSRF tokens.
SECRET_KEY=""
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# --- database --------------------------------------------------------------
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
PGDATA="/var/lib/postgresql/data"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- cache -----------------------------------------------------------------
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"
# rediss:// only: the server certificate and hostname are verified by default.
# Set REDIS_SSL_CA_CERTS to a CA bundle path inside the container for a private
# CA, or REDIS_SSL_CERT_REQS="none" to skip verification.
REDIS_SSL_CERT_REQS="required"
REDIS_SSL_CA_CERTS=""

# --- object storage --------------------------------------------------------
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires a change in the proxy config for uploads when MinIO is
# in use.
AWS_S3_BUCKET_NAME="uploads"
# set to 1 if using the pre-configured MinIO setup
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
SIGNED_URL_EXPIRATION=3600
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880

# --- urls ------------------------------------------------------------------
WEB_URL="http://localhost:8000"
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"
APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""
LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after this many days.
HARD_DELETE_AFTER_DAYS=60
# API key rate limit
API_KEY_RATE_LIMIT="60/minute"
# Number of reverse proxies in front of the API, used to read the client IP from
# X-Forwarded-For for rate limiting. Leave unset to keep the default behaviour.
# NUM_PROXIES=

# --- queue tuning (optional) ----------------------------------------------
# The Postgres-backed queue introduced at cutover. Defaults are in
# apps/server/ENV.md §4.1; uncomment only to tune.
# PLANE_RS_JOB_POLL_INTERVAL_MS=1000
# PLANE_RS_JOB_MAX_ATTEMPTS=5

# --- compose / proxy -------------------------------------------------------
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=
# For DNS-challenge certificate generation:
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# --- deprecated, accepted for compatibility --------------------------------
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_API_KEY=""
GPT_ENGINE="gpt-3.5-turbo"
DOCKERIZED=1
